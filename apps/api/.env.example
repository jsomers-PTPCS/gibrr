DATABASE_URL="postgresql://gibrr:gibrr@localhost:5432/gibrr"
PORT=4000
DOMAIN="localhost:4000"
WEB_ORIGIN="http://localhost:3000"

# "production" enables the session cookie's secure flag (https-only) and
# switches logging from pretty-printed to plain JSON lines. Leave unset
# for local dev over http.
NODE_ENV=

# Optional — base URL of a LibreTranslate instance (self-hosted; see
# docker-compose.prod.yml's own libretranslate service) for the
# "Translate this" post feature. Leave unset to disable translation
# entirely rather than pointing at a public instance — LibreTranslate's
# public API requires its own paid API key, same posture as SMTP being
# unconfigured by default.
LIBRETRANSLATE_URL=
