DATABASE_URL="postgresql://gibrr:gibrr@localhost:5432/gibrr"
PORT=4000
DOMAIN="localhost:4000"
WEB_ORIGIN="http://localhost:3000"

# "production" enables the session cookie's secure flag (https-only) and
# switches logging from pretty-printed to plain JSON lines. Leave unset
# for local dev over http.
NODE_ENV=

# Optional — if SMTP_HOST is unset, verification/reset emails are just
# logged instead of sent (fine for local dev, not for a real instance).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@localhost"
