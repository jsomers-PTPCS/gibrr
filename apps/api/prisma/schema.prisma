generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActorType {
  Person
  Group
}

model Actor {
  id          String    @id @default(uuid())
  username    String
  domain      String
  type        ActorType @default(Person)
  displayName String?
  summary     String?

  // Present only for local actors (this instance controls the keypair).
  publicKey   String
  privateKey  String?

  inboxUrl    String
  outboxUrl   String

  createdAt   DateTime  @default(now())

  followers   Follow[]  @relation("FollowingActor")
  following   Follow[]  @relation("FollowerActor")

  localUser   LocalUser?
  community   Community?
  posts       Post[]

  @@unique([username, domain])
}

enum FollowState {
  pending
  accepted
}

model Follow {
  id          String      @id @default(uuid())
  followerId  String
  followingId String
  state       FollowState @default(pending)
  createdAt   DateTime    @default(now())

  follower    Actor @relation("FollowerActor", fields: [followerId], references: [id])
  following   Actor @relation("FollowingActor", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model LocalUser {
  id           String    @id @default(uuid())
  actorId      String    @unique
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())

  actor        Actor     @relation(fields: [actorId], references: [id])
  sessions     Session[]
}

model Session {
  id          String   @id @default(uuid())
  localUserId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  localUser   LocalUser @relation(fields: [localUserId], references: [id])
}

model Community {
  id          String   @id @default(uuid())
  actorId     String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now())

  actor       Actor    @relation(fields: [actorId], references: [id])
  posts       Post[]
}

model Post {
  id            String    @id @default(uuid())
  title         String
  url           String?
  body          String?
  authorActorId String
  communityId   String
  createdAt     DateTime  @default(now())

  author        Actor     @relation(fields: [authorActorId], references: [id])
  community     Community @relation(fields: [communityId], references: [id])
}
